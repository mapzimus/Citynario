# Runtime
CITYNARIO_ENV=development
CITYNARIO_LOG_LEVEL=INFO
CITYNARIO_API_HOST=0.0.0.0
CITYNARIO_API_PORT=8000
CITYNARIO_CORS_ORIGINS=["http://localhost:5173"]

# PostGIS (local Docker defaults only; change outside local development)
POSTGRES_DB=citynario
POSTGRES_USER=citynario
POSTGRES_PASSWORD=citynario_local_only
DATABASE_URL=postgresql+asyncpg://citynario:citynario_local_only@db:5432/citynario

# Web (exposed to the browser; never put secrets in NEXT_PUBLIC_* values)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Planning assistant. The deterministic provider works without a key.
CITYNARIO_AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=
